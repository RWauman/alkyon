{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alkyon",
  "version": "1.0.0",
  "identifier": "be.bstorm.alkyon",
  "build": {
    "frontendDist": "http://127.0.0.1:8787"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "A portable data workbench",
    "longDescription": "Real dialect SQL against SQL Server, PostgreSQL, MySQL, MongoDB, a folder of files or Azure storage, with DuckDB federation across them and a terminal an agent can drive.",
    "licenseFile": "LICENSE",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libdbus-1-3"]
      }
    }
  }
}

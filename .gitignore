# Credentials
.env
# An ALKYON_SOURCES import file, which does carry passwords. Anchored to the root
# on purpose: a project's `.alkyon/sources.json` holds no credential and is meant
# to be committed.
/sources.json

# Rust
/target

# The grid bundle's build dependencies. Its *output* is committed under
# src/ui/vendor/, so building or running alkyon never needs npm — only changing
# the grid does.
/tools/grid/node_modules

# Scratch notes on what is left to do
/idea
